    {
      "name": "사진",
      "description": "필수 환경 변수: accessToken, groupId. 폴더 전체 실행은 R2 업로드 URL 발급 → 1x1 SVG PUT → 사진 등록 → 내 사진 조회 순서입니다. 실제 R2 오브젝트와 사진 데이터를 만듭니다.",
      "item": [
        {
          "name": "사진 업로드 URL 발급",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('R2 업로드 정보를 반환한다', () => {",
                  "  pm.expect(body.uploadUrl).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.objectKey).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.contentType).to.eql('image/svg+xml');",
                  "});",
                  "pm.collectionVariables.set('uploadUrl', body.uploadUrl);",
                  "pm.collectionVariables.set('objectKey', body.objectKey);",
                  "pm.collectionVariables.set('uploadContentType', body.contentType);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentType\": \"image/svg+xml\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/photos/upload-urls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "photos", "upload-urls"]
            }
          },
          "response": []
        },
        {
          "name": "R2에 테스트 이미지 업로드",
          "event": [
