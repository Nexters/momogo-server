    {
      "name": "03. 그룹 초대 흐름",
      "item": [
        {
          "name": "그룹 생성",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('그룹 ID와 초대 코드를 반환한다', () => {",
                  "  pm.expect(body.groupId).to.be.a('number').and.above(0);",
                  "  pm.expect(body.groupName).to.eql(pm.collectionVariables.get('groupName'));",
                  "  pm.expect(body.inviteCode).to.match(/^[A-Z0-9]{6}$/);",
                  "});",
                  "pm.collectionVariables.set('groupId', body.groupId);",
                  "pm.collectionVariables.set('inviteCode', body.inviteCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{groupName}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups"]
            }
          },
          "response": []
        },
        {
          "name": "초대 정보 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('참여 전 초대 정보를 반환한다', () => {",
                  "  pm.expect(body.groupId).to.eql(Number(pm.collectionVariables.get('groupId')));",
                  "  pm.expect(body.groupName).to.eql(pm.collectionVariables.get('groupName'));",
                  "  pm.expect(body.totalMemberCount).to.eql(1);",
                  "  pm.expect(body.participated).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{memberAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/invitations?code={{inviteCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "invitations"],
              "query": [{ "key": "code", "value": "{{inviteCode}}" }]
            }
          },
          "response": []
        },
