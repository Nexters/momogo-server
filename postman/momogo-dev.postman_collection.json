{
  "info": {
    "_postman_id": "027fab5c-16e3-4af0-bda1-f3de4303950b",
    "name": "Momogo dev API flows",
    "description": "Postman 앱에서 핵심 기능별로 골라 실행하는 dev API Collection입니다. 먼저 `인증/인증 준비`를 Send 하거나 환경에 accessToken을 입력한 뒤 필요한 기능 폴더를 실행합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "인증",
      "description": "`인증 준비`는 GUEST 로그인을 먼저 시도하고 사용자가 없을 때만 회원가입한 뒤 accessToken, refreshToken, userId를 환경에 저장합니다. providerToken이 비어 있으면 고유값을 자동 생성하고, 값이 있으면 기존 GUEST 사용자를 재사용합니다.",
      "item": [
        {
          "name": "인증 준비",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "['accessToken', 'refreshToken', 'userId'].forEach((key) => pm.environment.set(key, ''));",
                  "const required = ['baseUrl', 'nickname'];",
                  "const missing = required.filter((key) => !String(pm.environment.get(key) || '').trim());",
                  "pm.test('인증 준비 변수가 입력되어 있다', () => {",
                  "  pm.expect(missing, `비어 있는 변수: ${missing.join(', ')}`).to.be.empty;",
                  "});",
                  "if (missing.length > 0) {",
                  "  throw new Error(`인증 준비 중단: ${missing.join(', ')}`);",
                  "}",
                  "const nickname = String(pm.environment.get('nickname'));",
                  "if (nickname.length > 6) {",
                  "  throw new Error('nickname은 공백이 아닌 1~6자여야 합니다.');",
                  "}",
                  "let providerToken = String(pm.environment.get('providerToken') || '');",
                  "if (!providerToken.trim()) {",
                  "  providerToken = pm.variables.replaceIn('momogo-postman-{{$guid}}');",
                  "  pm.environment.set('providerToken', providerToken);",
                  "}",
                  "if (providerToken.length > 255) {",
                  "  throw new Error('providerToken은 255자 이하여야 합니다.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveAuth(response, label) {",
                  "  pm.test(`${label}은 200을 반환한다`, () => pm.expect(response.code).to.eql(200));",
                  "  if (response.code !== 200) return;",
                  "",
                  "  const contentType = String(response.headers.get('Content-Type') || '').split(';')[0].toLowerCase();",
                  "  pm.test(`${label}은 application/json을 반환한다`, () => pm.expect(contentType).to.eql('application/json'));",
                  "",
                  "  let body;",
                  "  try {",
                  "    body = response.json();",
                  "  } catch (error) {",
                  "    throw new Error(`${label} 응답이 JSON이 아닙니다: ${error.message}`);",
                  "  }",
                  "",
                  "  const valid = Number(body.userId) > 0 &&",
                  "    typeof body.accessToken === 'string' && body.accessToken.length > 0 &&",
                  "    typeof body.refreshToken === 'string' && body.refreshToken.length > 0;",
                  "  pm.test(`${label}은 사용자와 토큰을 반환한다`, () => pm.expect(valid).to.eql(true));",
                  "  if (!valid) throw new Error(`${label} 응답에 인증 정보가 없습니다.`);",
                  "",
                  "  pm.environment.set('userId', String(body.userId));",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "}",
                  "",
                  "const loginContentType = String(pm.response.headers.get('Content-Type') || '').split(';')[0].toLowerCase();",
                  "pm.test('로그인 응답은 JSON 계열이다', () => {",
                  "  pm.expect(loginContentType).to.match(/^application\\/(problem\\+)?json$/);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.test('기존 GUEST 사용자로 로그인했다', () => pm.expect(pm.response.code).to.eql(200));",
                  "  saveAuth(pm.response, '로그인');",
                  "} else if (pm.response.code === 404) {",
                  "  let problem;",
                  "  try {",
                  "    problem = pm.response.json();",
                  "  } catch (error) {",
                  "    throw new Error(`로그인 오류 응답이 JSON이 아닙니다: ${error.message}`);",
                  "  }",
                  "  pm.test('미가입 사용자는 USER_NOT_FOUND를 반환한다', () => {",
                  "    pm.expect(problem.code).to.eql('USER_NOT_FOUND');",
                  "  });",
                  "  if (problem.code !== 'USER_NOT_FOUND') {",
                  "    throw new Error(`예상하지 못한 로그인 오류: ${problem.code || pm.response.code}`);",
                  "  }",
                  "",
                  "  const baseUrl = String(pm.variables.get('baseUrl')).replace(/\\/+$/, '');",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/api/v1/user/register`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "      mode: 'raw',",
                  "      raw: JSON.stringify({",
                  "        provider: 'GUEST',",
                  "        providerToken: pm.variables.get('providerToken'),",
                  "        nickname: pm.variables.get('nickname')",
                  "      })",
                  "    }",
                  "  }, (error, response) => {",
                  "    pm.test('회원가입 요청 자체가 성공했다', () => pm.expect(error).to.not.exist);",
                  "    if (error) throw error;",
                  "    saveAuth(response, '회원가입');",
                  "  });",
                  "} else {",
                  "  pm.test('로그인 성공 또는 미가입 응답이다', () => {",
                  "    throw new Error(`예상하지 못한 로그인 상태: ${pm.response.code}`);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"GUEST\",\n  \"providerToken\": \"{{providerToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "한 번 Send 하면 GUEST 로그인을 먼저 시도합니다. providerToken이 비어 있으면 `momogo-postman-<GUID>`를 환경에 저장하며, 404 USER_NOT_FOUND일 때만 같은 값과 nickname으로 회원가입합니다. 성공하면 accessToken, refreshToken, userId를 환경에 저장합니다."
          },
          "response": []
        },
        {
          "name": "토큰 재발급",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('새 토큰을 반환한다', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reissue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reissue"]
            },
            "description": "필수 환경 변수: refreshToken. 성공하면 accessToken과 refreshToken을 새 값으로 교체합니다."
          },
          "response": []
        }
      ]
    },
    {
