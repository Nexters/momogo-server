{
  "info": {
    "_postman_id": "027fab5c-16e3-4af0-bda1-f3de4303950b",
    "name": "Momogo dev API integration",
    "description": "dev OpenAPI 계약을 실제 서버에서 검증하는 순차 통합 테스트입니다. 임시 게스트 사용자와 그룹은 마지막 단계에서 정리합니다. 사진 업로드 및 Discord 신고 성공 테스트는 enablePhotoReport=true일 때만 한 번 실행합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. 공개 API와 인증 경계",
      "item": [
        {
          "name": "리액션 문구 조회 및 실행 초기화",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
                  "const runtimeVariables = [",
                  "  'ownerUserId', 'ownerAccessToken', 'ownerRefreshToken', 'ownerOldRefreshToken',",
                  "  'memberUserId', 'memberAccessToken', 'memberRefreshToken',",
                  "  'groupId', 'inviteCode', 'uploadUrl', 'objectKey', 'uploadContentType', 'photoId'",
                  "];",
                  "runtimeVariables.forEach((key) => pm.collectionVariables.unset(key));",
                  "if (pm.info.iteration === 0) {",
                  "  pm.collectionVariables.unset('photoReportCallCount');",
                  "}",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('ownerProviderToken', `postman-owner-${runId}`);",
                  "pm.collectionVariables.set('memberProviderToken', `postman-member-${runId}`);",
                  "pm.collectionVariables.set('ownerNickname', '테스트A');",
                  "pm.collectionVariables.set('updatedOwnerNickname', '수정A');",
                  "pm.collectionVariables.set('memberNickname', '테스트B');",
                  "pm.collectionVariables.set('groupName', 'Postman 그룹');",
                  "pm.collectionVariables.set('updatedGroupName', '수정된 그룹');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('revision과 comments 계약을 만족한다', () => {",
                  "  pm.expect(body).to.have.property('revision');",
                  "  pm.expect(body.comments).to.be.an('array');",
                  "  body.comments.forEach((comment) => {",
                  "    pm.expect(comment.concept).to.be.a('string');",
                  "    pm.expect(comment.emoji).to.be.a('string');",
                  "    pm.expect(comment.contents).to.be.an('array');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/init/comments",
              "host": ["{{baseUrl}}"],
              "path": ["init", "comments"]
            },
            "description": "첫 요청에서 실행별 고유 변수와 임시 데이터 변수를 초기화합니다."
          },
          "response": []
        },
        {
          "name": "앱 버전 확인",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('버전 응답 계약을 만족한다', () => {",
                  "  pm.expect(body.latestVersion).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.minSupportedVersion).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.forceUpdate).to.be.a('boolean');",
                  "  pm.expect(body.updateUrl).to.be.a('string').and.match(/^https?:\\/\\//);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/init/versions?platform={{platform}}&appVersion={{appVersion}}",
              "host": ["{{baseUrl}}"],
              "path": ["init", "versions"],
              "query": [
                { "key": "platform", "value": "{{platform}}" },
                { "key": "appVersion", "value": "{{appVersion}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "인증 없이 내 정보 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401을 반환한다', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('INVALID_AUTH_CREDENTIALS 문제 응답을 반환한다', () => {",
                  "  pm.expect(body.status).to.eql(401);",
                  "  pm.expect(body.code).to.eql('INVALID_AUTH_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. 사용자와 토큰 수명주기",
      "item": [
        {
          "name": "그룹 소유자 가입",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('인증 토큰과 사용자 정보를 반환한다', () => {",
                  "  pm.expect(body.userId).to.be.a('number').and.above(0);",
                  "  pm.expect(body.nickname).to.eql(pm.collectionVariables.get('ownerNickname'));",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('ownerUserId', body.userId);",
                  "pm.collectionVariables.set('ownerAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('ownerRefreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"GUEST\",\n  \"providerToken\": \"{{ownerProviderToken}}\",\n  \"nickname\": \"{{ownerNickname}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "register"]
            }
          },
          "response": []
        },
        {
          "name": "소유자 내 정보 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('가입한 사용자 정보와 일치한다', () => {",
                  "  pm.expect(body.userId).to.eql(Number(pm.collectionVariables.get('ownerUserId')));",
                  "  pm.expect(body.nickname).to.eql(pm.collectionVariables.get('ownerNickname'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "me"]
            }
          },
          "response": []
        },
        {
          "name": "소유자 닉네임 변경",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('변경한 닉네임을 반환한다', () => {",
                  "  pm.expect(body.userId).to.eql(Number(pm.collectionVariables.get('ownerUserId')));",
                  "  pm.expect(body.nickname).to.eql(pm.collectionVariables.get('updatedOwnerNickname'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"{{updatedOwnerNickname}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user"]
            }
          },
          "response": []
        },
        {
          "name": "소유자 토큰 재발급",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ownerOldRefreshToken', pm.collectionVariables.get('ownerRefreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('새 토큰 쌍을 반환한다', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).not.to.eql(pm.collectionVariables.get('ownerOldRefreshToken'));",
                  "});",
                  "pm.collectionVariables.set('ownerAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('ownerRefreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{ownerRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reissue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reissue"]
            }
          },
          "response": []
        },
        {
          "name": "폐기된 refresh token 재사용",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404를 반환한다', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('INVALID_REFRESH_TOKEN 문제 응답을 반환한다', () => {",
                  "  pm.expect(body.status).to.eql(404);",
                  "  pm.expect(body.code).to.eql('INVALID_REFRESH_TOKEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{ownerOldRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reissue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reissue"]
            }
          },
          "response": []
        },
        {
          "name": "그룹 참여자 가입",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('두 번째 사용자 인증 정보를 반환한다', () => {",
                  "  pm.expect(body.userId).to.be.a('number').and.above(0);",
                  "  pm.expect(body.userId).not.to.eql(Number(pm.collectionVariables.get('ownerUserId')));",
                  "  pm.expect(body.nickname).to.eql(pm.collectionVariables.get('memberNickname'));",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('memberUserId', body.userId);",
                  "pm.collectionVariables.set('memberAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('memberRefreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"GUEST\",\n  \"providerToken\": \"{{memberProviderToken}}\",\n  \"nickname\": \"{{memberNickname}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "register"]
            }
          },
          "response": []
        }
      ]
