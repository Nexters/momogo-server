                  "pm.test('참여한 그룹 정보를 반환한다', () => {",
                  "  pm.expect(body.groupId).to.eql(Number(pm.collectionVariables.get('groupId')));",
                  "  pm.expect(body.code).to.eql(pm.collectionVariables.get('inviteCode'));",
                  "});"
                ]
