              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requiredIds = ['groupId', 'photoId'];",
                  "const invalidIds = requiredIds.filter((key) => !/^[1-9]\\d*$/.test(String(pm.variables.get(key) || '').trim()));",
              "const reason = String(pm.variables.get('reason') || '');",
              "if (invalidIds.length > 0) throw new Error(`환경에 유효한 ID를 입력하세요: ${invalidIds.join(', ')}`);",
              "if (!reason.trim()) throw new Error('환경 변수 reason을 입력하세요. 이 요청은 실제 Discord 메시지를 전송합니다.');",
              "if (reason.length > 500) throw new Error('환경 변수 reason은 500자 이하여야 합니다.');",
              "const photoReportBody = JSON.stringify({ reason });",
              "pm.test('신고 사유가 JSON 본문에 그대로 보존된다', () => {",
              "  pm.expect(JSON.parse(photoReportBody).reason).to.eql(reason);",
              "});",
              "pm.variables.set('photoReportBody', photoReportBody);"
                ]
              }
            },
