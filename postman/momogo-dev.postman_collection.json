        {
          "name": "참여 그룹 목록 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const groupId = Number(pm.collectionVariables.get('groupId'));",
                  "pm.test('생성한 그룹이 목록에 있다', () => {",
                  "  pm.expect(body.date).to.be.a('string');",
                  "  pm.expect(body.groups).to.be.an('array');",
                  "  const group = body.groups.find((candidate) => candidate.groupId === groupId);",
                  "  pm.expect(group).to.be.an('object');",
                  "  pm.expect(group.totalMemberCount).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups"]
            }
          },
          "response": []
        },
        {
          "name": "그룹 상세 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200을 반환한다', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const userIds = body.members.map((member) => member.userId);",
                  "pm.test('두 사용자가 그룹 상세에 있다', () => {",
                  "  pm.expect(body.groupId).to.eql(Number(pm.collectionVariables.get('groupId')));",
                  "  pm.expect(body.groupName).to.eql(pm.collectionVariables.get('groupName'));",
                  "  pm.expect(userIds).to.include(Number(pm.collectionVariables.get('ownerUserId')));",
                  "  pm.expect(userIds).to.include(Number(pm.collectionVariables.get('memberUserId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{memberAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}"]
            }
          },
          "response": []
        },
        {
          "name": "그룹 이름 변경",
          "event": [
            {
