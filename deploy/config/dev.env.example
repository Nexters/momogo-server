# API 서버의 /opt/momogo/config/dev.env로 복사한 뒤 실제 값으로 변경한다.
# 시크릿이 포함되므로 dev.env는 Git에 커밋하지 않고 권한을 600으로 설정한다.
IMAGE_REPOSITORY=ghcr.io/nexters/momogo-server
DB_HOST=postgres-dev.internal
DB_PORT=5432
DB_NAME=momogo
DB_USERNAME='replace-me'
# $, #, 공백 같은 문자가 그대로 유지되도록 시크릿 값은 작은따옴표로 감싼다.
DB_PASSWORD='replace-me'
HOST_PORT=8081
JWT_ISSUER=momogo-server
JWT_SECRET_BASE64='replace-with-base64-encoded-random-bytes'
R2_ENDPOINT='https://replace-with-account-id.r2.cloudflarestorage.com'
R2_BUCKET='replace-with-dev-bucket-name'
R2_ACCESS_KEY_ID='replace-me'
R2_SECRET_ACCESS_KEY='replace-me'
PHOTO_REPORT_DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/000000000000000000/replace-me'
HEALTH_RETRIES=20
HEALTH_INTERVAL_SECONDS=3
